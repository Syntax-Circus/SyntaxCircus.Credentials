<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SyntaxCircus.Credentials</PackageId>
    <Title>SyntaxCircus Credentials</Title>
    <Description>A cross-platform desktop credential vault: Windows Credential Manager, macOS Keychain, Linux secret-tool/libsecret (with an AES-256 encrypted-file fallback), and a factory that picks the right one for the current OS.</Description>
    <Authors>Syntax Circus LLC</Authors>
    <Company>Syntax Circus LLC</Company>
    <Copyright>Copyright © Syntax Circus LLC</Copyright>
    <PackageTags>credentials;keychain;secrets;desktop</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Syntax-Circus/SyntaxCircus.Credentials</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntax-Circus/SyntaxCircus.Credentials</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="GitVersion.MsBuild" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
